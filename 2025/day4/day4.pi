
main =>
    Greys = "%odwm|-+~<>:.",
    % Data = read_file_lines("test.txt"),
    Data = read_file_lines("day.txt"),

    Cell = [D : D in Data], % [Y,X] addresses
    Cell2 = Cell,
    W = len(Cell[1]),
    H = len(Cell),
    Part2 = [],
    P = 0,
    do
        display(Cell,W,H),
        command("sleep .05") = _,
        P := 0,
        foreach (Y in 1..H, X in 1..W)
            if (Cell[Y,X] = '@', valid(nbors([Y,X],Cell,W,H)) < 4)
                then 
                    P := P + 1,
                    Cell2[Y,X] := Greys[1]
            end,
            if (nth(I, Greys, Cell[Y,X]), I < Greys.len) 
                then Cell2[Y,X] := Greys[I+1]
            end
        end,
        Part2 := Part2 ++ [P],
        Cell := Cell2
    while (P > 0),
    display(Cell,W,H),

    printf("Part 1: %w\n",Part2[1]),
    printf("Part 2: %w\n",sum(Part2)),
    printf("%c[?25h", chr(27)). % show cursor

valid(Nbors) = sum([1 : N in Nbors, N = '@']).

nbors([Y,X],Cell,W,H) = Nbors =>
    Deltas =[[DY,DX] : DY in -1..1, DX in -1..1, [DY,DX] != [0,0]],
    Nbors = [Cell[NY,NX] : [DY,DX] in Deltas, 
            NX = X+DX, NY = Y+DY, 
            between(1,H,NY), between(1,W,NX)].

display(Cell,W,H) =>
    printf("%c[?25l", chr(27)), % hide cursor
    printf("%c[2J%c[H", chr(27), chr(27)), % clear screen
    foreach(Y in 1..H)
        println(Cell[Y])
    end.


