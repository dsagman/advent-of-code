main =>
    % Data = read_file_lines("test.txt").map(parse),
    Data = read_file_lines("day.txt").map(parse),

    P = 50,
    Part1 = 0,
    foreach(D in Data)
        P := rotate(P,D),    
        if P == 0 then Part1 := Part1 + 1 end,
    end,
    printf("Answer Part 1: %w\n",Part1),

    % brute force ;-)
    Part2 = 0,
    P := 50,
    foreach(D in Data)
        if D > 0 then Di = 1 else Di = -1 end,
        foreach(I in 1..abs(D))
            P := rotate(P,Di),
            if P == 0 then Part2 := Part2 + 1 end
        end
    end,
    printf("Answer Part 2: %w\n",Part2).


rotate(P,X) = (P + X) mod 100.

parse(['L'|X]) = to_int(['-'|X]).
parse(['R'|X]) = to_int(X).