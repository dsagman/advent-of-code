
main =>
    % Data = read_file_lines("test.txt").map(parse),
    Data = read_file_lines("day.txt").map(parse),

    Part1 = sum([best_sum(D,2) : D in Data]),
    printf("Answer Part 1: %w\n",Part1),

    Part2 = sum([best_sum(D,12) : D in Data]),
    printf("Answer Part 2: %w\n",Part2).

best_sum(L,N) = Best =>
    Left = 1,
    Right = L.len-(N-1),
    Maxs = [],
    foreach(I in 1..N)
        Max = max(slice(L, Left, Right)),
        Maxs := Maxs ++ [Max],
        MaxIdx = first_idx(L,Max,Left),
        Left := MaxIdx + 1,
        Right := Right + 1,
    end,
    Best = sum([Maxs[I]*(10**(N-I)) : I in 1..N]).

parse(D) = map(to_int,D).

first_idx(L,X,S) = I =>
    I = S,
    while (L[I] != X, I <= L.len)
        I := I + 1
    end.

