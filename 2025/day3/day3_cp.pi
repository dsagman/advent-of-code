
import sat.
import util.

main =>
    % Data = read_file_lines("test.txt").map(parse),
    Data = read_file_lines("day.txt").map(parse),

    Jolts = [],
    foreach(I in 1..Data.len)
        Pair = best_sum(Data[I],2),
        printf("%w ",I),
        Jolts := Jolts ++ [Pair],
    end,
    printf("\nAnswer Part 1: %w\n",sum(Jolts)),

    Jolts2 = [],
    foreach(I in 1..Data.len)
        Twelve = best_sum(Data[I],12),
        printf("%w ",I),
        % println(Twelve),
        Jolts2 := Jolts2 ++ [Twelve],
    end,
    printf("\nAnswer Part 2: %w\n",sum(Jolts2)).

best_sum(L,N) = Best =>
    Is = new_array(N),
    Is :: 1..L.len,
    increasing_strict(Is),
    Best #= sum([V*(10**(N-I)) : I in 1..N, element(Is[I],L,V)]),
    solve($[max(Best)],[Is]).

parse(D) = map(to_int,D).
