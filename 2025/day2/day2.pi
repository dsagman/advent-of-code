
import util.

main =>
    % Data = read_file_chars("test.txt").split(",").map(parse),
    Data = read_file_chars("day.txt").split(",").map(parse),
    
    Invs1 = [],
    foreach(D in Data)
        foreach(I in D[1].to_int..D[2].to_int)
            Pow = 10 ** (I.to_string.len//2),
            if (I // Pow == I mod Pow) then Invs1 := Invs1 ++ [I] end
        end
    end,
    printf("Answer Part 1: %w\n",sum(Invs1)),

    Invs2 = [],
    foreach(D in Data)
        foreach(I in D[1].to_int..D[2].to_int)
            Istr = I.to_string,
            foreach(J in 1..Istr.len//2)
                Chunks = chunks_of(Istr, J),
                if all_equal(Chunks) then Invs2 := Invs2 ++ [I] end
            end
        end
    end,
    Part2 = sort_remove_dups(Invs2),
    printf("Answer Part 2: %w\n",sum(Part2)).


% parse(D) = map(to_int,split(D, "-")).
parse(D) = split(D, "-").

all_equal([]) => true.
all_equal([_]) => true.
all_equal([X,Y|Xs]) => X==Y, all_equal([Y|Xs]). 