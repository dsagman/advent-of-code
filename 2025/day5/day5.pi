
import util.

main =>
    % Data = read_file_lines("test.txt"),
    Data = read_file_lines("day.txt"),

    nth(Split, Data, []),
    R = slice(Data, 1, Split-1).map(parse).sort,
    Ing = slice(Data, Split+1).map(to_int),

    Part1 = sum([in_range(I,R) : I in Ing]),
    printf("Part 1: %w\n", Part1),

    Part2Total = 0,
    CurrentMax = -1, % Tracks the highest element encountered
    
    foreach ([Start, End] in R)
        if End > CurrentMax then
            % Calculate non-overlapping portion extending beyond CurrentMax
            ActualStart = max(Start, CurrentMax + 1),
            Part2Total := Part2Total + (End - ActualStart + 1),
            CurrentMax := End
        end
    end,
    println(part2total=Part2Total),

    printf("Part 2: %d\n", Part2Total),

    Part2 = sum_merge(R),
    printf("Part 2: %w\n", Part2).

parse(D) = split(D, "-").map(to_int).

in_range(X,[]) = 0.
in_range(X,[[Low,High]|T]) = cond(between(Low,High,X),1,in_range(X,T)).

sum_merge([A]) = A[2]-A[1]+1.
sum_merge([A,B|T]) = cond(B[1]<=A[2], 
    sum_merge([[A[1],max(A[2],B[2])]|T]), 
    (A[2]-A[1]+1) + sum_merge([B|T])).


